# Work tracking: Backlog.md tasks committed inside each repository.
#
# A repo's work lives next to its code as markdown under `backlog/`,
# written through the upstream `backlog` CLI (which validates statuses,
# priorities and labels against the project config). Core owns that
# config: it is rendered from these options and placed on shell entry,
# so every repo shares one lifecycle and agents never hand-edit it.
# Upstream owns the file format and the agent workflow guides
# (`backlog instructions`); the `work-tracking` skill adds only the
# conventions on top.
#
# Inert until `prefix` is set: no package, no placement.
{
  lib,
  config,
  agenticInputs,
  ...
}: let
  cfg = config.agentic.workTracking;

  configText = ''
    # GENERATED by agentic (agentic.workTracking) on shell entry. Change
    # the module options, not this file; `backlog config set` edits are
    # overwritten.
    project_name: ${builtins.toJSON cfg.projectName}
    task_prefix: ${builtins.toJSON cfg.prefix}
    default_status: ${builtins.toJSON cfg.defaultStatus}
    statuses: ${builtins.toJSON cfg.statuses}
    priorities: ${builtins.toJSON cfg.priorities}
    types: ${builtins.toJSON cfg.types}
    labels: ${builtins.toJSON cfg.labels}
    definition_of_done: ${builtins.toJSON cfg.definitionOfDone}
    auto_commit: false
    remote_operations: true
    check_active_branches: true
    auto_open_browser: false
  '';

  configFile = pkgs: pkgs.writeText "backlog-config.yml" configText;

  placeScript = pkgs:
    lib.optionalString (cfg.prefix != null) ''
      mkdir -p ${lib.escapeShellArg cfg.directory}
      install -m 644 ${configFile pkgs} ${lib.escapeShellArg "${cfg.directory}/config.yml"}
    '';
in {
  options.agentic.workTracking = {
    prefix = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "fin";
      description = ''
        Task ID prefix (`fin` gives `FIN-1`). Setting it enables work
        tracking for the repository.
      '';
    };

    projectName = lib.mkOption {
      type = lib.types.str;
      default = "project";
      description = "Backlog project name shown on the board.";
    };

    directory = lib.mkOption {
      type = lib.types.str;
      default = "backlog";
      description = "Repository-relative backlog folder.";
    };

    statuses = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = ["Backlog" "Exploring" "Planning" "Approved" "Implementing" "Verifying" "Review" "Done"];
      description = ''
        Board columns, in lifecycle order; the last is the final status.
        Cancelled, duplicate and invalid work is archived, not given a
        status.
      '';
    };

    defaultStatus = lib.mkOption {
      type = lib.types.str;
      default = builtins.head cfg.statuses;
      defaultText = lib.literalExpression "builtins.head statuses";
      description = "Status of newly created tasks.";
    };

    priorities = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = ["Show-stopper" "Critical" "Major" "Normal" "Minor"];
      description = "Ordered priority labels, highest first. Priority expresses consequence, not queue order.";
    };

    types = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = ["Epic" "Feature" "Task" "Bug" "Usability Problem" "Performance Problem"];
      description = "Allowed task types. An Epic is a finishable parent whose subtasks carry the work.";
    };

    labels = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Allowed labels (for example the repository's subsystems).";
    };

    definitionOfDone = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Checklist added to every new task.";
    };

    lib = lib.mkOption {
      type = lib.types.raw;
      readOnly = true;
      description = "Helpers: `package pkgs` (null where upstream ships none), `configFile pkgs`, `placeScript pkgs`.";
    };
  };

  config.agentic.workTracking.lib = {
    package = agenticInputs.backlogBase;
    inherit configFile placeScript;
  };
}
